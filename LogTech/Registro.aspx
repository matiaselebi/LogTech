<%@ Page Title="Crear cuenta" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Registro.aspx.cs" Inherits="LogTech.Registro" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <main class="account-page">
        <section class="container account-shell" aria-labelledby="registroTitle">
            <header class="account-heading">
                <span class="eyebrow">NUEVA CUENTA</span>
                <h1 id="registroTitle">Empezá a usar LogTech</h1>
                <p>Completá tus datos y elegí cómo vas a utilizar la plataforma.</p>
            </header>

            <div class="account-card">
                <p class="required-note"><span>*</span> Campos obligatorios</p>
                <div class="form-grid">
                    <div class="form-field"><label for="<%= txtNombre.ClientID %>">Nombre <span class="required-mark">*</span></label><asp:TextBox ID="txtNombre" runat="server" CssClass="form-control" MaxLength="60" data-tipo="nombre" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtNombre" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtNombre" ValidationExpression="^[A-Za-zÀ-ÖØ-öø-ÿ][A-Za-zÀ-ÖØ-öø-ÿ' \-]+$" ErrorMessage="Usá solo letras (mínimo 2)." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field"><label for="<%= txtApellido.ClientID %>">Apellido <span class="required-mark">*</span></label><asp:TextBox ID="txtApellido" runat="server" CssClass="form-control" MaxLength="60" data-tipo="nombre" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtApellido" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtApellido" ValidationExpression="^[A-Za-zÀ-ÖØ-öø-ÿ][A-Za-zÀ-ÖØ-öø-ÿ' \-]+$" ErrorMessage="Usá solo letras (mínimo 2)." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field"><label for="<%= txtCorreo.ClientID %>">Correo electrónico <span class="required-mark">*</span></label><asp:TextBox ID="txtCorreo" runat="server" CssClass="form-control" TextMode="Email" MaxLength="100" autocomplete="email" data-tipo="correo" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtCorreo" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtCorreo" ValidationExpression="^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$" ErrorMessage="Ingresá un correo válido (ej.: nombre@empresa.com)." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field"><label for="<%= txtTelefono.ClientID %>">Teléfono <span class="required-mark">*</span></label><asp:TextBox ID="txtTelefono" runat="server" CssClass="form-control" MaxLength="10" data-tipo="digitos" inputmode="numeric" placeholder="Solo números" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtTelefono" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtTelefono" ValidationExpression="^\d{10}$" ErrorMessage="El teléfono tiene que tener 10 números (código de área sin 0 y número sin 15)." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field"><label for="<%= txtCuitCuil.ClientID %>">CUIT / CUIL <span class="required-mark">*</span></label><asp:TextBox ID="txtCuitCuil" runat="server" CssClass="form-control" MaxLength="11" placeholder="Solo números" data-tipo="digitos" inputmode="numeric" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtCuitCuil" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtCuitCuil" ValidationExpression="^\d{11}$" ErrorMessage="El CUIT/CUIL tiene que tener 11 números." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field"><label for="<%= ddlCondicionIva.ClientID %>">Condición frente al IVA <span class="required-mark">*</span></label><asp:DropDownList ID="ddlCondicionIva" runat="server" CssClass="form-select account-select"><asp:ListItem Value="" Text="Seleccionar" /><asp:ListItem Value="Responsable inscripto" Text="Responsable inscripto" /><asp:ListItem Value="Monotributista" Text="Monotributista" /><asp:ListItem Value="Exento" Text="Exento" /><asp:ListItem Value="Consumidor final" Text="Consumidor final" /></asp:DropDownList><asp:RequiredFieldValidator runat="server" ControlToValidate="ddlCondicionIva" InitialValue="" ErrorMessage="Elegí tu condición frente al IVA." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field"><label for="<%= txtUsuario.ClientID %>">Nombre de usuario <span class="required-mark">*</span></label><asp:TextBox ID="txtUsuario" runat="server" CssClass="form-control" MaxLength="50" autocomplete="username" data-tipo="usuario" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtUsuario" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtUsuario" ValidationExpression="^[a-z0-9._\-]{4,50}$" ErrorMessage="De 4 a 50 caracteres: minúsculas, números, punto, guion o guion bajo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <div class="form-field form-grid-full"><label for="<%= ddlPerfil.ClientID %>">¿Cómo vas a usar LogTech? <span class="required-mark">*</span></label><asp:DropDownList ID="ddlPerfil" runat="server" CssClass="form-select account-select"><asp:ListItem Value="">Seleccionar perfil</asp:ListItem><asp:ListItem Value="Transportista">Soy transportista</asp:ListItem><asp:ListItem Value="Dador de carga">Soy dador de carga</asp:ListItem><asp:ListItem Value="Administrador de Flota">Tengo una flota de camiones</asp:ListItem></asp:DropDownList><asp:RequiredFieldValidator runat="server" ControlToValidate="ddlPerfil" InitialValue="" ErrorMessage="Elegí cómo vas a usar LogTech." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                    <%-- Qué se puede hacer con cada perfil, en palabras simples: se ve el del perfil elegido. --%>
                    <div class="form-grid-full perfil-permisos" data-perfil="Dador de carga">Con este perfil vas a poder publicar tus cargas, elegir quién las lleva y seguir cada viaje hasta la entrega.</div>
                    <div class="form-grid-full perfil-permisos" data-perfil="Transportista">Con este perfil vas a poder tomar cargas de la bolsa, llevarlas con tu camión y cobrar cada viaje.</div>
                    <div class="form-grid-full perfil-permisos" data-perfil="Administrador de Flota">Con este perfil vas a poder cargar tus camiones y conductores, tomar cargas y asignarle cada viaje a tu equipo.</div>
                    <asp:Panel ID="pnlTransportista" runat="server" CssClass="form-field form-grid-full profile-field"><label for="<%= txtLicencia.ClientID %>">Número de licencia <span class="required-mark">*</span></label><asp:TextBox ID="txtLicencia" runat="server" CssClass="form-control" MaxLength="40" data-tipo="licencia" /><asp:CustomValidator runat="server" ControlToValidate="txtLicencia" ClientValidationFunction="licenciaObligatoria" ValidateEmptyText="true" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtLicencia" ValidationExpression="^[A-Za-z0-9\-]{4,40}$" ErrorMessage="De 4 a 40 letras, números o guiones." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></asp:Panel>
                    <asp:Panel ID="pnlDador" runat="server" CssClass="form-field form-grid-full profile-field"><label for="<%= txtRazonSocial.ClientID %>">Razón social <span class="required-mark">*</span></label><asp:TextBox ID="txtRazonSocial" runat="server" CssClass="form-control" MaxLength="120" /><asp:CustomValidator runat="server" ControlToValidate="txtRazonSocial" ClientValidationFunction="razonSocialObligatoria" ValidateEmptyText="true" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></asp:Panel>
                    <div class="form-field"><label for="<%= txtClave.ClientID %>">Contraseña <span class="required-mark">*</span></label><asp:TextBox ID="txtClave" MaxLength="64" runat="server" CssClass="form-control" TextMode="Password" autocomplete="new-password" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtClave" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:RegularExpressionValidator runat="server" ControlToValidate="txtClave" ValidationExpression="^(?=.*[A-ZÀ-ÖØ-Þ])(?=.*[^A-Za-zÀ-ÖØ-öø-ÿ0-9\s]).{8,}$" ErrorMessage="Mínimo 8 caracteres, una mayúscula y un carácter especial." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><small>Mínimo 8 caracteres, una mayúscula y un carácter especial.</small></div>
                    <div class="form-field"><label for="<%= txtConfirmarClave.ClientID %>">Confirmar contraseña <span class="required-mark">*</span></label><asp:TextBox ID="txtConfirmarClave" MaxLength="64" runat="server" CssClass="form-control" TextMode="Password" autocomplete="new-password" /><asp:RequiredFieldValidator runat="server" ControlToValidate="txtConfirmarClave" ErrorMessage="Completá este campo." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /><asp:CompareValidator runat="server" ControlToValidate="txtConfirmarClave" ControlToCompare="txtClave" ErrorMessage="Las contraseñas no coinciden." Display="Dynamic" CssClass="validador" SetFocusOnError="true" ValidationGroup="Registro" /></div>
                </div>
                <asp:Label ID="lblMensaje" runat="server" CssClass="form-error" role="alert" />
                <div class="account-buttons"><asp:Button ID="btnCrearCuenta" runat="server" Text="Crear cuenta" CssClass="btn btn-brand btn-lg" OnClick="btnCrearCuenta_Click" CausesValidation="true" ValidationGroup="Registro" /><a runat="server" href="~/Login.aspx" class="btn btn-outline-dark btn-lg">Volver al inicio de sesión</a></div>
            </div>
        </section>
    </main>
    <script>
        (function () {
            var perfil = document.getElementById('<%= ddlPerfil.ClientID %>');
            var transportista = document.getElementById('<%= pnlTransportista.ClientID %>');
            var dador = document.getElementById('<%= pnlDador.ClientID %>');
            function actualizarPerfil() {
                transportista.style.display = perfil.value === 'Transportista' ? 'block' : 'none';
                dador.style.display = perfil.value === 'Dador de carga' || perfil.value === 'Administrador de Flota' ? 'block' : 'none';
                document.querySelectorAll('.perfil-permisos').forEach(function (lista) {
                    lista.style.display = lista.getAttribute('data-perfil') === perfil.value ? 'block' : 'none';
                });
            }
            // Licencia y razón social son obligatorias según el perfil elegido (CustomValidator).
            window.licenciaObligatoria = function (validador, args) { args.IsValid = perfil.value !== 'Transportista' || args.Value.trim() !== ''; };
            window.razonSocialObligatoria = function (validador, args) { args.IsValid = (perfil.value !== 'Dador de carga' && perfil.value !== 'Administrador de Flota') || args.Value.trim() !== ''; };
            perfil.addEventListener('change', actualizarPerfil);
            actualizarPerfil();
        }());
    </script>
</asp:Content>
