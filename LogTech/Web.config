<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <appSettings file="Web.Mail.config">
    <!-- Claves CorreoSmtp* (host/puerto/usuario/clave) para mandar correo real van en
         Web.Mail.config, no acá: ese archivo está en .gitignore y nunca se sube al repo. -->
    <!-- Traducción: App_Data/Traducciones (lo que falte se pide a MyMemory, sin clave). -->
    <!-- Usuario de contingencia: entra sin base de datos para restaurar un backup.
         Clave por defecto: LogTech-Restore-2026 -->
    <add key="ContingenciaUsuario" value="contingencia" />
    <add key="ContingenciaClaveSalt" value="contingencia-salt-2026" />
    <add key="ContingenciaClaveHash" value="CE69F40AD0C5530E250C57DFC55A7A7C050A98020ABD0BB0F459895DC156E984" />
    <!-- Clave AES-256 (32 bytes en Base64) con la que se cifran los datos personales (CifradoServicio). Si se cambia,
         los datos ya cifrados no se pueden leer: en producción se protege esta sección con aspnet_regiis. -->
    <add key="ClaveCifrado" value="+qfhO3TOhH9w7r405U57XmE6l7H5POZYDfgU2dvxJVg=" />
    <!-- Carpeta donde se guardan y desde donde se restauran los backups. -->
    <add key="CarpetaBackups" value="~/App_Data/Backups" />
    <!-- Avisos de la Parte 1 (viajes, documentos): siempre quedan en el panel; con "true" también van por correo. -->
    <add key="AvisosPorCorreo" value="true" />
    <!-- ARCA simulado (facturas): false simula que no responde y las facturas quedan pendientes de CAE (ERR022). -->
    <add key="ArcaDisponible" value="true" />
    <!-- Aseguradoras simuladas: false simula que no responden al emitir una póliza (ERR042). -->
    <add key="AseguradoraDisponible" value="true" />
    <!-- Punto 10b: el sitio va por HTTPS con el certificado de IIS Express (puerto SSL del proyecto). Vacío = no se fuerza. -->
    <add key="PuertoHttps" value="44303" />
    <!-- Los gráficos del tablero (asp:Chart) se generan como imagen en memoria y se
         borran apenas el navegador los descarga. -->
    <add key="ChartImageHandler" value="storage=memory;deleteAfterServicing=true;" />
  </appSettings>
  <connectionStrings>
    <!-- Base de datos. Con SQL Server Express (instancia con nombre) va Data Source=.\SQLEXPRESS. -->
    <add name="LogTechDB" connectionString="Data Source=localhost;Initial Catalog=LogTechDB;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <!-- Por defecto ASP.NET corta requests de más de 4 MB: justo lo que rompía la subida
         del .bak en Restaurar backup. maxRequestLength es en KB; 512000 = 500 MB. -->
    <httpRuntime targetFramework="4.7.2" maxRequestLength="512000" executionTimeout="300" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="es-AR" uiCulture="es" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
      <controls>
        <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <!-- IIS también corta el request antes de que llegue a ASP.NET; sin esto,
         maxRequestLength de arriba no alcanza (límite de IIS por defecto: ~28 MB). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
    <!-- El navegador vuelve a pedir el CSS y el JS en cada página (le responden 304 si no cambiaron): así un cambio
         de estilo se ve sin tener que apretar Ctrl+F5. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <!-- Sirve las imágenes de los gráficos del tablero (ChartImg.axd). -->
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST" path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.net>
    <!-- Por defecto guarda cada correo como archivo .eml en App_Data/Mails, no manda nada real.
         El envío real (Gmail/Hotmail) se configura con claves CorreoSmtp* en appSettings,
         puestas en Web.Mail.config (ver arriba) para que la contraseña no vaya al repo. -->
    <mailSettings>
      <smtp deliveryMethod="SpecifiedPickupDirectory" from="logtech.notificaciones@logtech.local" />
    </mailSettings>
  </system.net>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>
